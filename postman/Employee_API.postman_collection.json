{
  "info": {
    "name": "Jtronix Employee API",
    "description": "Run in order against a running local API. Creation captures employee_id for subsequent requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "employee_id",
      "value": "4"
    }
  ],
  "item": [
    {
      "name": "01 - Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
              "pm.test(\"Healthy\", function () { pm.expect(pm.response.json().status).to.eql(\"ok\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      },
      "response": []
    },
    {
      "name": "02 - List employees",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
              "pm.test(\"Contains sample employee\", function () { pm.expect(pm.response.json().some(e => e.id === 1 && e.name === \"Rahul Sharma\")).to.eql(true); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/employees"
      },
      "response": []
    },
    {
      "name": "03 - Get employee",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
              "pm.test(\"Correct employee\", function () { pm.expect(pm.response.json().id).to.eql(1); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/employees/1"
      },
      "response": []
    },
    {
      "name": "04 - Filter department",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
              "pm.test(\"Engineering only\", function () { const employees = pm.response.json(); pm.expect(employees.length).to.be.at.least(2); employees.forEach(e => pm.expect(e.department.toLowerCase()).to.eql(\"engineering\")); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/employees?department=engineering"
      },
      "response": []
    },
    {
      "name": "05 - Create employee",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
              "pm.test(\"New employee defaults\", function () { const e = pm.response.json(); pm.expect(e.name).to.eql(\"Neha Singh\"); pm.expect(e.status).to.eql(\"Active\"); pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/employees/\" + e.id); });",
              "pm.collectionVariables.set(\"employee_id\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/employees",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Neha Singh\",\n  \"department\": \"Sales\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "06 - Get created employee",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
              "pm.test(\"Saved employee\", function () { pm.expect(pm.response.json().name).to.eql(\"Neha Singh\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/employees/{{employee_id}}"
      },
      "response": []
    },
    {
      "name": "07 - Update status",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
              "pm.test(\"Status updated\", function () { pm.expect(pm.response.json().status).to.eql(\"Inactive\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/employees/{{employee_id}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Inactive\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "08 - Verify updated employee",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
              "pm.test(\"Status persisted\", function () { pm.expect(pm.response.json().status).to.eql(\"Inactive\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/employees/{{employee_id}}"
      },
      "response": []
    },
    {
      "name": "09 - Missing employee",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });",
              "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
              "pm.test(\"Missing employee error\", function () { pm.expect(pm.response.json().error).to.eql(\"Employee not found.\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/employees/2147483647"
      },
      "response": []
    },
    {
      "name": "10 - Reject blank name",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
              "pm.test(\"Name validation\", function () { pm.expect(pm.response.json().fields).to.have.property(\"name\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/employees",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"  \",\n  \"department\": \"Sales\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "11 - Reject invalid status",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
              "pm.test(\"Status validation\", function () { pm.expect(pm.response.json().error).to.eql(\"Status must be either Active or Inactive.\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/employees/{{employee_id}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Pending\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "12 - Missing employee on update",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });",
              "pm.test(\"JSON response\", function () { pm.response.to.be.json; });"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/employees/2147483647/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Active\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    }
  ]
}
